# UROC Data Visualizer Environment Configuration
#
# This file contains environment variables used by the UROC visualization nodes
# to configure runtime behavior. These settings affect the performance and
# update rates of the visualization system.

# Visualization refresh rate configuration (Hz)
# Controls how frequently visualization nodes update their published data:
# - Transform publishers (gimbal_frame, map_tf_publisher)
# - Marker publishers (gimbal_visualizer, velocity_vector_visualizer)  
# - Path accumulation (path_visualizer)
#
# Current setting: 0.1 Hz = updates every 10 seconds
# - Higher values (e.g., 1.0, 10.0) = more frequent updates, higher CPU usage
# - Lower values (e.g., 0.05, 0.01) = less frequent updates, lower CPU usage
# 
# Note: This is a global setting that affects all visualization nodes.
# Individual nodes may have their own internal rate limiting.
REFRESH_RATE_HZ=0.1
